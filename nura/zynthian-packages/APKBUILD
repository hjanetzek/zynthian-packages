# zynthian-packages for postmarketOS/Nura: the catalogue of zynthian's installable content packs
# (soundfonts, samples, IRs): per pack its info.yml, art and a bash script that downloads the data
# from its origin (os.zynthian.org, GitHub). No data itself. webconf's "Extra Packs" page reads it
# from $ZYNTHIAN_DIR/zynthian-packages (/usr/share/zynthian/zynthian-packages) and runs the scripts.
# zynthian-factory-content installs what ZynthianOS' image comes with (see the script).
#
# Built from a checkout of zynthian-packages (nura branch):
#   pmbootstrap build --src=/path/to/zynthian-packages zynthian-packages
pkgname=zynthian-packages
pkgver=0_git20261108
pkgrel=2
pkgdesc="zynthian synthesizer platform: catalogue and install scripts of the content packs"
url="https://github.com/zynthian/zynthian-packages"
arch="noarch"
license="GPL-3.0-or-later"
options="!check"
# The pack scripts: bash, downloads with wget or git, archives with tar/xz or unzip
depends="bash git tar unzip wget xz"
builddir="$srcdir/$pkgname"

package() {
	local dest="$pkgdir"/usr/share/zynthian/zynthian-packages
	mkdir -p "$dest"
	# The catalogue as the repository has it, without its CI and this recipe
	tar -cf - --exclude=./.git --exclude=./.github --exclude=./nura . | tar -xf - -C "$dest"
	find "$dest" -name '*.sh' -exec chmod 755 {} +

	# Where the packs' data goes: system data with zynthian-data's layout beside the read-only
	# /usr/share/zynthian/zynthian-data (zynthian-ui's desktop environment picks it up as
	# ZYNTHIAN_PACKS_DATA_DIR). webconf runs as the device user: group audio, setgid.
	install -d -m 2775 -g audio "$pkgdir"/var/lib/zynthian/zynthian-data

	# What ZynthianOS' image includes and Nura's leaves out (large data from elsewhere): packages
	# kept out of the image and the packs ZynthianOS has installed, for the factory snapshots
	install -Dm755 nura/zynthian-packages/zynthian-factory-content -t "$pkgdir"/usr/bin/
}
